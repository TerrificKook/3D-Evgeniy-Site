# Локальный адрес по умолчанию: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# staging | production. В staging robots.txt запрещает индексацию.
NEXT_PUBLIC_SITE_MODE=staging

# Числовой ID. Если пусто, скрипт Яндекс Метрики не загружается.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Будущий адаптер формы. Сейчас поддерживается только безопасный mock.
LEAD_ADAPTER=mock

# Защитные флаги публичного запуска. Не ставьте true без фактического подтверждения.
PUBLIC_CONTENT_CONFIRMED=false
PRIVACY_POLICY_APPROVED=false
CONTACTS_CONFIRMED=false
